{
  "name": "crdtrade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BTC paper-trading bot: one tested strategy, live Binance prices, built for multi-day unattended paper tests.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
